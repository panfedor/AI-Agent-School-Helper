    {
      "parameters": {
        "jsCode": "// Получаем входные данные\nconst items = $input.all();\nconst dataArray = items[0].json.data || [];\n\n// Создаем текстовый буфер\nlet textForAI = \"Вот список постов для дайджеста:\\n\\n\";\n\n// Проходимся по каждому посту и добавляем его в текст\ndataArray.forEach((item, index) => {\n  // Очищаем текст от лишнего (FetchRSS и HTML теги, если есть)\n  let cleanText = item.contentSnippet\n    .replace('(Feed generated with FetchRSS)', '')\n    .trim();\n    \n  textForAI += `--- ПОСТ #${index + 1} ---\\n`;\n  textForAI += `КАНАЛ: ${item.channelName}\\n`;\n  textForAI += `ТЕКСТ: ${cleanText}\\n\\n`;\n});\n\ntextForAI += \"Конец списка постов.\";\n\n// Возвращаем результат в простом формате\nreturn [{\n  json: {\n    prompt_text: textForAI\n  }\n}];"
      },
